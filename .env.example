# Copy to .env and fill in real values. NEVER commit .env (git-ignored).
# Constitution Principle 9: secrets are never hardcoded or committed.

APP_NAME=AI Customer Support Worker
ENVIRONMENT=development

# PostgreSQL connection (matches docker-compose postgres service)
DATABASE_URL=postgresql+psycopg://support:support@localhost:5432/support

# Session signing secret — MUST be a long random value in real deployments
SESSION_SECRET=change-me-in-env

# LLM provider (optional for MVP; deterministic answer path does not call the LLM)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_TEMPERATURE=0.0

# Path to the approved knowledge seed (backend/data/knowledge_seed.json)
KNOWLEDGE_SEED_PATH=data/knowledge_seed.json
